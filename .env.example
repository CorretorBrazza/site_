# URL pública da API (Railway). Em produção, defina na Netlify; o código tem
# fallback para o host de produção, mas depender dele faz o dev local acertar
# dados reais.
NEXT_PUBLIC_API_URL=https://imoveis-taboao-api-production-4cd9.up.railway.app

# WhatsApp exibido no site (somente dígitos, com DDI e DDD).
NEXT_PUBLIC_WHATSAPP_NUMBER=5511989161897
NEXT_PUBLIC_DEFAULT_WHATSAPP=5511989161897

# Origens extras de imagem/script/conexão para a CSP, separadas por espaço.
# Ex.: CSP_IMG_SRC="https://res.cloudinary.com https://cdn.exemplo.com"
CSP_IMG_SRC=
CSP_SCRIPT_SRC=
CSP_CONNECT_SRC=
